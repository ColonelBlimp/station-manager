{
    "name": "station-manager-desktop",
    "private": true,
    "version": "0.0.0",
    "description": "Station Manager desktop shell (ADR 0102, W-0027). Development only: not released.",
    "license": "GPL-3.0-only",
    "type": "module",
    "main": "src/main.mjs",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "electron .",
        "check:a1": "SM_DESKTOP_SCENARIO=a1 electron .",
        "check:c1": "SM_DESKTOP_SCENARIO=c1 electron .",
        "check:c1d-shell": "SM_DESKTOP_SCENARIO=c1d-shell electron .",
        "check:c1d": "SM_DESKTOP_SCENARIO=c1d electron .",
        "check:c2b": "SM_DESKTOP_SCENARIO=c2b electron .",
        "check:c2b-smd": "SM_DESKTOP_SCENARIO=c1d SM_DESKTOP_REQUIRE_APP=1 electron .",
        "test:unit": "node --test test/discovery.test.mjs test/daemon.test.mjs test/smd-process.test.mjs test/mode.test.mjs test/imports.test.mjs test/trace.test.mjs test/waiting.test.mjs test/credential.test.mjs",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "electron": "44.9.3",
        "eslint": "10.6.0",
        "globals": "17.7.0",
        "prettier": "3.9.4"
    }
}
