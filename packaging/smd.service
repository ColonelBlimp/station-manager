[Unit]
Description=Station Manager daemon (smd)
Documentation=https://github.com/ColonelBlimp/station-manager
After=network-online.target
Wants=network-online.target

# Bound the restart flap. Without this the default limit (5/10s) never trips —
# RestartSec=5s spaces restarts ~5-6s apart, so only ~1 lands in each 10s window
# and a daemon that can't start (e.g. :8080 already held by a dev `task run:smd`,
# or a corrupt config) respawns FOREVER every few seconds. With a 120s window,
# 5 rapid failures trip the limit and the unit enters `failed` and STOPS, instead
# of hammering the machine. A genuine one-off transient (slow boot) still
# recovers. Recover a tripped unit with: systemctl --user reset-failed smd.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# The daemon resolves its working directory via $SM_WORKING_DIR — see
# internal/utils.WorkingDir(). Without this, the executable-dir fallback
# would land in /usr/bin/, which is read-only and wrong for user data.
Environment=SM_WORKING_DIR=%h/.local/share/station-manager
# Declares to the daemon that THIS unit will respawn it, so POST /v1/restart is
# enabled (self-restart via ExitRestart below). Kept in lockstep with the
# Restart= / RestartForceExitStatus= lines: a unit that drops the respawn config
# must also drop this, or the daemon would exit and stay stopped. cmd/smd gates
# the endpoint on it (not on INVOCATION_ID, which every systemd unit has).
Environment=SM_SELF_RESTART=1
ExecStart=/usr/bin/smd
Restart=on-failure
# Exit code 3 (ExitRestart) is a PLANNED self-restart requested via POST
# /v1/restart — force the respawn explicitly so it stays a restart even if the
# Restart= policy ever changes, and so it reads as intentional (not a crash /
# ExitError=1) in the journal. on-failure already respawns any non-zero exit, so
# the feature works before this line is deployed; this just makes the intent
# explicit + robust.
RestartForceExitStatus=3
RestartSec=5s
# Absolute backstop on graceful shutdown. The daemon runs its own budget-bounded
# teardown (server.shutdown_timeout_sec, default 10s — see cmd/smd gracefulShutdown,
# LC-2) and records the stage that overran, so its OWN report fires first. This line
# is the OS-level cap that SIGKILLs the process if the daemon itself wedges past 20s.
# It is ABSOLUTE: a config with server.shutdown_timeout_sec ABOVE 20 will still be cut
# off here — raise this value in lockstep if a larger app budget is ever configured.
TimeoutStopSec=20s

[Install]
WantedBy=default.target
