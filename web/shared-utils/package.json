{
  "name": "@station-manager/shared-utils",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/lib/svelte/index.d.ts",
      "svelte": "./dist/lib/svelte/index.js",
      "import": "./dist/lib/svelte/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "5.53.5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "svelte": "5.53.5",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}