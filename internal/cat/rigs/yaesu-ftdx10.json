{
  "id": "yaesu-ftdx10",
  "name": "Yaesu FTdx10",
  "manufacturer": "Yaesu",
  "model": "FTdx10",
  "family": "yaesu",
  "ft8_mode": "DATA-U",
  "description": "Yaesu FTdx10 HF/50MHz SDR transceiver. ASCII CAT terminated by ';'. Push-state updates via AI mode. Commands, states, tag names, and mode mappings lifted from v1's battle-tested default (internal/config/defaults.go on the v1 branch).",
  "terminator": ";",
  "serial": {
    "baud_rate": 38400,
    "data_bits": 8,
    "stop_bits": 1,
    "parity": "none",
    "line_delimiter": ";",
    "read_timeout_ms": 8,
    "write_timeout_ms": 20,
    "rts": false,
    "dtr": false
  },
  "timing": {
    "listener_interval_ms": 10,
    "listener_read_timeout_ms": 8
  },
  "commands": [
    {"name": "INIT",     "cmd": "AI1;"},
    {"name": "READ",     "cmd": "ID;FA;FB;ST;VS;MD0;MD1;PC;"},
    {"name": "PLAYBACK", "cmd": "PB0%s;"},
    {"name": "set_freq",   "cmd": "FA%s;", "pad": 9, "min": 30000, "max": 75000000, "exposed": true},
    {"name": "set_freq_b", "cmd": "FB%s;", "pad": 9, "min": 30000, "max": 75000000, "exposed": true},
    {"name": "set_mode", "cmd": "MD0%s;", "value_map": "MAINMODE", "exposed": true},
    {"name": "swap_vfo", "cmd": "SV;",                            "exposed": true},
    {"name": "band_up",   "cmd": "BU0;", "exposed": true},
    {"name": "band_down", "cmd": "BD0;", "exposed": true},
    {"name": "set_band",  "cmd": "BS%s;", "value_map": "BAND", "exposed": true},
    {"name": "set_power", "cmd": "PC%s;", "pad": 3, "min": 5, "max": 100, "exposed": true},
    {"name": "tx_on",     "cmd": "TX1;"},
    {"name": "tx_off",    "cmd": "TX0;"},
    {"name": "read_tx_status", "cmd": "TX;"}
  ],
  "states": [
    {
      "prefix": "ID",
      "markers": [
        {"tag": "IDENTITY", "index": 0, "length": 4, "value_mappings": [
          {"key": "0761", "value": "FTdx10"}
        ]}
      ]
    },
    {
      "prefix": "FA",
      "markers": [
        {"tag": "VFOAFREQ", "index": 0, "length": 9}
      ]
    },
    {
      "prefix": "FB",
      "markers": [
        {"tag": "VFOBFREQ", "index": 0, "length": 9}
      ]
    },
    {
      "prefix": "ST",
      "markers": [
        {"tag": "SPLIT", "index": 0, "length": 1, "value_mappings": [
          {"key": "0", "value": "OFF"},
          {"key": "1", "value": "ON"},
          {"key": "2", "value": "ON+"}
        ]}
      ]
    },
    {
      "prefix": "VS",
      "markers": [
        {"tag": "SELECT", "index": 0, "length": 1, "value_mappings": [
          {"key": "0", "value": "VFO-A"},
          {"key": "1", "value": "VFO-B"}
        ]}
      ]
    },
    {
      "prefix": "MD0",
      "markers": [
        {"tag": "MAINMODE", "index": 0, "length": 1, "value_mappings": [
          {"key": "1", "value": "LSB"},
          {"key": "2", "value": "USB"},
          {"key": "3", "value": "CW-U"},
          {"key": "4", "value": "FM"},
          {"key": "5", "value": "AM"},
          {"key": "6", "value": "RTTY-L"},
          {"key": "7", "value": "CW-L"},
          {"key": "8", "value": "DATA-L"},
          {"key": "9", "value": "RTTY-U"},
          {"key": "A", "value": "DATA-FM"},
          {"key": "B", "value": "FM-N"},
          {"key": "C", "value": "DATA-U"},
          {"key": "D", "value": "AM-N"},
          {"key": "E", "value": "PSK"},
          {"key": "F", "value": "DATA-FM-N"}
        ]}
      ]
    },
    {
      "prefix": "MD1",
      "markers": [
        {"tag": "SUBMODE", "index": 0, "length": 1, "value_mappings": [
          {"key": "1", "value": "LSB"},
          {"key": "2", "value": "USB"},
          {"key": "3", "value": "CW-U"},
          {"key": "4", "value": "FM"},
          {"key": "5", "value": "AM"},
          {"key": "6", "value": "RTTY-L"},
          {"key": "7", "value": "CW-L"},
          {"key": "8", "value": "DATA-L"},
          {"key": "9", "value": "RTTY-U"},
          {"key": "A", "value": "DATA-FM"},
          {"key": "B", "value": "FM-N"},
          {"key": "C", "value": "DATA-U"},
          {"key": "D", "value": "AM-N"},
          {"key": "E", "value": "PSK"},
          {"key": "F", "value": "DATA-FM-N"}
        ]}
      ]
    },
    {
      "prefix": "PC",
      "markers": [
        {"tag": "TXPWR", "index": 0, "length": 3}
      ]
    },
    {
      "prefix": "BS",
      "markers": [
        {"tag": "BAND", "index": 0, "length": 2, "value_mappings": [
          {"key": "00", "value": "160m"},
          {"key": "01", "value": "80m"},
          {"key": "02", "value": "60m"},
          {"key": "03", "value": "40m"},
          {"key": "04", "value": "30m"},
          {"key": "05", "value": "20m"},
          {"key": "06", "value": "17m"},
          {"key": "07", "value": "15m"},
          {"key": "08", "value": "12m"},
          {"key": "09", "value": "10m"},
          {"key": "10", "value": "6m"}
        ]}
      ]
    },
    {
      "prefix": "TX",
      "markers": [
        {"tag": "TXSTATUS", "index": 0, "length": 1}
      ]
    },
    {
      "prefix": "RM4",
      "markers": [
        {"tag": "ALC", "index": 0, "length": 3}
      ]
    },
    {
      "prefix": "RM5",
      "markers": [
        {"tag": "PO", "index": 0, "length": 3}
      ]
    },
    {
      "prefix": "RM6",
      "markers": [
        {"tag": "SWR", "index": 0, "length": 3}
      ]
    }
  ],
  "mode_mappings": {
    "LSB":        {"mode": "SSB",  "submode": "LSB"},
    "USB":        {"mode": "SSB",  "submode": "USB"},
    "CW-U":       {"mode": "CW"},
    "CW-L":       {"mode": "CW"},
    "FM":         {"mode": "FM"},
    "FM-N":       {"mode": "FM"},
    "AM":         {"mode": "AM"},
    "AM-N":       {"mode": "AM"},
    "RTTY-L":     {"mode": "RTTY"},
    "RTTY-U":     {"mode": "RTTY"},
    "DATA-L":     {"mode": "FT8"},
    "DATA-U":     {"mode": "FT8"},
    "DATA-FM":    {"mode": "FM"},
    "DATA-FM-N":  {"mode": "FM"},
    "PSK":        {"mode": "PSK",  "submode": "PSK31"}
  }
}
