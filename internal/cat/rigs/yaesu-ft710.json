{
  "id": "yaesu-ft710",
  "name": "Yaesu FT-710",
  "manufacturer": "Yaesu",
  "model": "FT-710",
  "family": "yaesu",
  "description": "Yaesu FT-710 HF/50MHz SDR transceiver. Verified against FT-710_CAT_OM_ENG_2306-C. Mostly mirrors the FTdx10 (same Yaesu ASCII+';' family, same mode codes, same FA/FB/PC/PB/AI/VS formats). Differences from the FTdx10: identity code is 0800 (not 0761); SPLIT only has 0/1 (no ON+). VS P1 semantically maps main-band to VFO-A or VFO-B (operationally equivalent to FTdx10).",
  "terminator": ";",
  "serial": {
    "baud_rate": 38400,
    "data_bits": 8,
    "stop_bits": 1,
    "parity": "none",
    "line_delimiter": ";",
    "read_timeout_ms": 8,
    "write_timeout_ms": 20,
    "rts": true,
    "dtr": true
  },
  "timing": {
    "listener_interval_ms": 10,
    "listener_read_timeout_ms": 8
  },
  "commands": [
    {"name": "INIT",     "cmd": "AI1;ID;"},
    {"name": "READ",     "cmd": "FA;FB;ST;VS;MD0;MD1;PC;"},
    {"name": "PLAYBACK", "cmd": "PB0%s;"}
  ],
  "states": [
    {
      "prefix": "ID",
      "markers": [
        {"tag": "IDENTITY", "index": 0, "length": 4, "value_mappings": [
          {"key": "0800", "value": "FT-710"}
        ]}
      ]
    },
    {
      "prefix": "FA",
      "markers": [
        {"tag": "VFOAFREQ", "index": 0, "length": 9}
      ]
    },
    {
      "prefix": "FB",
