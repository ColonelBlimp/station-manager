{
  "id": "icom-ic7300",
  "name": "Icom IC-7300",
  "manufacturer": "Icom",
  "model": "IC-7300",
  "family": "icom",
  "protocol": "icom_civ",
  "civ_address": "94",
  "ft8_mode": "USB-D",
  "description": "Icom IC-7300 HF/50MHz SDR transceiver. Icom CI-V binary protocol (FE FE..FD frames, addressed bus), push-state via CI-V Transceive. The first non-Yaesu rig and first CI-V rig; commands, mode codes, and addressing bench-validated on the borrowed rig 2026-06-14 (ADR 0034). RX-state + inbound freq/mode ops; TX (tune/FT8-TX) and power are deferred to the on-rig TX-validation step. Operator prerequisites (install.md): CI-V Transceive ON, CI-V USB Port = Link to [REMOTE], connect baud = CI-V Baud Rate (NOT the dormant CI-V USB Baud Rate), USB SEND = OFF.",
  "terminator": "0xFD",
  "serial": {
    "baud_rate": 19200,
    "data_bits": 8,
    "stop_bits": 1,
    "parity": "none",
    "line_delimiter": "0xFD",
    "read_timeout_ms": 50,
    "rts": false,
    "dtr": false
  },
  "timing": {
    "listener_interval_ms": 10,
    "listener_read_timeout_ms": 50
  },
  "commands": [
    {"name": "INIT", "cmd": "03", "encoding": "none"},
    {"name": "READ", "encoding": "frame_seq", "frames": ["03", "04"]},
    {"name": "set_freq", "cmd": "05", "encoding": "bcd_freq", "exposed": true},
    {"name": "set_mode", "cmd": "06", "encoding": "mode_seq", "exposed": true, "mode_seq": [
      {"mode": "LSB",    "frames": ["0600:01"]},
      {"mode": "USB",    "frames": ["0601:01"]},
      {"mode": "AM",     "frames": ["0602:01"]},
      {"mode": "CW",     "frames": ["0603:01"]},
      {"mode": "RTTY",   "frames": ["0604:01"]},
      {"mode": "FM",     "frames": ["0605:01"]},
      {"mode": "CW-R",   "frames": ["0607:01"]},
      {"mode": "RTTY-R", "frames": ["0608:01"]},
      {"mode": "LSB-D",  "frames": ["0600:01", "1A06:0101"]},
      {"mode": "USB-D",  "frames": ["0601:01", "1A06:0101"]}
    ]}
  ],
  "states": [
    {
      "prefix": "00",
      "markers": [
        {"tag": "VFOAFREQ", "kind": "bcd_freq", "index": 0, "length": 5}
      ]
    },
    {
      "prefix": "03",
      "markers": [
        {"tag": "VFOAFREQ", "kind": "bcd_freq", "index": 0, "length": 5}
      ]
    },
    {
      "prefix": "01",
      "markers": [
        {"tag": "MAINMODE", "kind": "byte", "index": 0, "length": 1, "value_mappings": [
          {"key": "00", "value": "LSB"},
          {"key": "01", "value": "USB"},
          {"key": "02", "value": "AM"},
          {"key": "03", "value": "CW"},
          {"key": "04", "value": "RTTY"},
          {"key": "05", "value": "FM"},
          {"key": "07", "value": "CW-R"},
          {"key": "08", "value": "RTTY-R"}
        ]}
      ]
    },
    {
      "prefix": "04",
      "markers": [
        {"tag": "MAINMODE", "kind": "byte", "index": 0, "length": 1, "value_mappings": [
          {"key": "00", "value": "LSB"},
          {"key": "01", "value": "USB"},
          {"key": "02", "value": "AM"},
          {"key": "03", "value": "CW"},
          {"key": "04", "value": "RTTY"},
          {"key": "05", "value": "FM"},
          {"key": "07", "value": "CW-R"},
          {"key": "08", "value": "RTTY-R"}
        ]}
      ]
    }
  ],
  "mode_mappings": {
    "LSB":    {"mode": "SSB", "submode": "LSB"},
    "USB":    {"mode": "SSB", "submode": "USB"},
    "AM":     {"mode": "AM"},
    "CW":     {"mode": "CW"},
    "CW-R":   {"mode": "CW"},
    "RTTY":   {"mode": "RTTY"},
    "RTTY-R": {"mode": "RTTY"},
    "FM":     {"mode": "FM"},
    "LSB-D":  {"mode": "FT8"},
    "USB-D":  {"mode": "FT8"}
  }
}
