.env
internal/logging/config.json
build/
!build/config.json.orig
!build/bin/.gitkeep
!build/db/.gitkeep
!build/log/.gitkeep
.task
/internal/cat/config.json

/logging

# Frontend SPA — node_modules never tracked; dist/ is built by Vite
# but the placeholder dist/index.html is committed so go:embed compiles
# before anyone runs `task frontend:install`.
frontend/logging/node_modules/
frontend/logging/dist/*
!frontend/logging/dist/index.html
# Stray repo-root node_modules (e.g. vitest cache left behind by running
# from the wrong cwd) — Go project, never legitimate here.
/node_modules/
/smd

config.json
/db
/log

# Local reference materials (papers, specs, datasheets). ARRL-copyright
# QEX paper etc. lives here for Claude / operator reference; not committed.
/references/
*.test
/ft8-eval
/ft8-stage-probe
/ft8-capture-probe
/ft8-gen10cq
/find-candidates
/decode-eval
/sweep-gates
/synth-subtract-probe
/decoded.txt
/jt9_wisdom.dat
/timer.out
