.env
internal/logging/config.json
build/
!build/config.json.orig
!build/bin/.gitkeep
!build/db/.gitkeep
!build/log/.gitkeep
.task
/internal/cat/config.json

/logging

# Frontend SPA — node_modules never tracked; dist/ is built by Vite.
# dist/index.html IS committed (so `//go:embed all:logging/dist` compiles
# before the first local build, and so the embedded daemon has a real page);
# the rest of dist/ (the built assets) is gitignored. This is only safe
# because the entry bundle has STABLE, hash-free names — assets/index.js +
# assets/index.css (see frontend/logging/vite.config.ts). So a fresh build
# always produces the SAME index.html: it never drifts from the gitignored
# dist/assets/, and committing it (even via stage-all) can't reintroduce the
# blank-page bug a hash-referencing index.html caused. Just rebuild before
# previewing on the embedded daemon (8080); for live SPA dev use Vite (5173).
frontend/logging/node_modules/
frontend/logging/dist/*
!frontend/logging/dist/index.html
# Config SPA — same rule as logging: node_modules untracked, dist/ built by
# Vite, dist/index.html committed so `//go:embed all:config/dist` compiles.
frontend/config/node_modules/
frontend/config/dist/*
!frontend/config/dist/index.html
# Logbook SPA — same rule as logging: node_modules untracked, dist/ built by
# Vite, dist/index.html committed so `//go:embed all:logbook/dist` compiles.
frontend/logbook/node_modules/
frontend/logbook/dist/*
!frontend/logbook/dist/index.html
# Stray repo-root node_modules (e.g. vitest cache left behind by running
# from the wrong cwd) — Go project, never legitimate here.
/node_modules/
# Catch-all: any node_modules at ANY depth (the anchored SPA paths above don't
# match nested strays like frontend/logging/src/node_modules/.vite, a Vite dep
# cache vitest can deposit there). node_modules is never source — ignore it
# wherever it lands.
**/node_modules/
/smd

config.json
/db
/log
/.claude/commands/log.md
/catcli
# Ignore .claude/ contents (local commands, settings.local.json, caches) but
# SHARE the committed hook config so the session-start orientation hook reaches
# every machine. Negation works only because the directory itself isn't excluded.
/.claude/*
!/.claude/settings.json