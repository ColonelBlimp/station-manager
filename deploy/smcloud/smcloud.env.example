# SM Cloud service environment — copy to /etc/smcloud/smcloud.env, then:
#   chmod 0600 /etc/smcloud/smcloud.env && chown root:root /etc/smcloud/smcloud.env
# This file holds SECRETS (bearer token, DB password) — never commit a real one.
# Full runbook: docs/smcloud-deploy.md.

# VPS posture: loopback ONLY — TLS is the reverse proxy's job (Caddy/nginx);
# the plain-HTTP listener must never face the internet.
# LAN staging posture (runbook Phase 1): bind the LAN interface instead
# (0.0.0.0:8091), no proxy — but never port-forward it through the router.
SMCLOUD_LISTEN=127.0.0.1:8091

# Postgres DSN. Local same-VPS Postgres shown; a managed instance works the
# same (use its host + sslmode=require).
SMCLOUD_DSN=postgres://smcloud:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/smcloud?sslmode=disable

# Tenant 1 — the operator/station callsign that owns the backed-up log.
SMCLOUD_CALLSIGN=7Q5MLV

# In-flight request cap (optional; default 16 ≈ 3× the DB pool). Over-limit
# requests get an immediate 503 + Retry-After instead of queuing, and the
# accept-time connection cap scales with it (4×) — together they bound the
# process; per-IP abuse policy belongs at the reverse proxy
# (see Caddyfile.example).
#SMCLOUD_MAX_CONCURRENT=16

# Bearer token the daemon's smcloud forwarder authenticates with.
# Generate:  openssl rand -base64 32
# The service REFUSES to start with this placeholder or a token under 32
# characters. The SAME value goes into the daemon's forwarder credentials
# (config SPA → Forwarding → SM Cloud backup → Bearer token).
SMCLOUD_TOKEN=CHANGE_ME_TOKEN

# --- Additional tenants (multi-tenancy, ADR 0052 milestone 1) ---
# Numbered pairs SMCLOUD_CALLSIGN_N / SMCLOUD_TOKEN_N with N in 2..32 (the
# unnumbered pair above is tenant 1). Each tenant gets its OWN token
# (openssl rand -base64 32), which goes into THAT operator's daemon forwarder
# credentials. Indices need not be contiguous. Boot REFUSES: a pair missing
# either half, an SMCLOUD_CALLSIGN_*/SMCLOUD_TOKEN_* variable it can't parse,
# a duplicate token (would merge two tenants), and a duplicate callsign (two
# tokens per tenant is the future device-tokens milestone, not this one).
# Rotating one tenant's token = edit its line + systemctl restart smcloud;
# no other tenant is touched. Removing a tenant's PAIR revokes their access;
# their data stays in Postgres (it's a backup service).
#SMCLOUD_CALLSIGN_2=7Q8AC
#SMCLOUD_TOKEN_2=CHANGE_ME_TOKEN_2
