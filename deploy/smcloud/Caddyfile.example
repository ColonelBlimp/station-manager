# Caddy reverse proxy for smcloud — automatic Let's Encrypt TLS (ADR 0040 S6).
# Install: append to /etc/caddy/Caddyfile (distro package `caddy`), set your
# hostname, then `systemctl reload caddy`. DNS for the hostname must already
# point at the VPS. Full runbook: docs/smcloud-deploy.md.

cloud.station-manager.org {
	# Per-IP rate limiting (pre-Phase-2 gate, decided 2026-07-18). This layer
	# is abuse policy — it sees real client IPs, which smcloud never does
	# behind a proxy; smcloud's own in-process concurrency cap (503 +
	# Retry-After, -max-concurrent) is the process-safety backstop underneath.
	#
	# NOTE: the stock Caddy package has NO rate-limit handler. Build one in:
	#   xcaddy build --with github.com/mholt/caddy-ratelimit
	# (or tick "http.handlers.rate_limit" on caddyserver.com/download), then
	# uncomment. 60 events/min per IP is generous for a daemon's legitimate
	# traffic — a 10 s worker tick + hourly reconcile + the odd export is
	# well under 10/min — while capping an abusive client at noise level.
	#
	# rate_limit {
	#	zone smcloud_per_ip {
	#		key    {client_ip}
	#		events 60
	#		window 1m
	#	}
	# }

	# smcloud listens on loopback only (SMCLOUD_LISTEN=127.0.0.1:8091);
	# Caddy terminates TLS and proxies. Bearer auth is smcloud's own.
	reverse_proxy 127.0.0.1:8091

	# A full-logbook export/backfill on a slow link can be long-running.
	# Caddy's defaults have no response timeout, so nothing to raise here —
	# this block exists so a future timeout tweak has an obvious home.
}
