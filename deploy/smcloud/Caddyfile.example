# Caddy reverse proxy for smcloud — automatic Let's Encrypt TLS (ADR 0040 S6).
# Install: append to /etc/caddy/Caddyfile (distro package `caddy`), set your
# hostname, then `systemctl reload caddy`. DNS for the hostname must already
# point at the VPS. Full runbook: docs/smcloud-deploy.md.

cloud.station-manager.org {
	# Per-IP rate limiting (pre-Phase-2 gate, decided 2026-07-18). This layer
	# is abuse policy — it sees real client IPs, which smcloud never does
	# behind a proxy; smcloud's own in-process concurrency cap (503 +
	# Retry-After, -max-concurrent) is the process-safety backstop underneath.
	#
	# NOTE: the stock Caddy package has NO rate-limit handler, and `xcaddy
	# build --with github.com/mholt/caddy-ratelimit` only produces ./caddy in
	# the current directory — it must be installed over the packaged binary
	# and verified (`caddy list-modules | grep rate_limit`) BEFORE enabling
	# the listener. Runbook §4 (docs/smcloud-deploy.md) has the full order;
	# then uncomment. 60 events/min per IP is generous for a daemon's
	# legitimate traffic — a 10 s worker tick + hourly reconcile + the odd
	# export is well under 10/min — while capping an abusive client at noise
	# level.
	#
	# rate_limit {
	#	zone smcloud_per_ip {
	#		key    {client_ip}
	#		events 60
	#		window 1m
	#	}
	# }

	# ---------------------------------------------------------------------
	# PRECONDITION — the official Caddy packages do NOT create /var/log/caddy,
	# and Caddy runs unprivileged and cannot mkdir under root-owned /var/log.
	# A file logger it cannot open FAILS THE RELOAD, and a Caddy that will not
	# start takes the whole service offline. Before reloading (runbook §4b):
	#
	#   sudo install -d -o caddy -g caddy -m 0750 /var/log/caddy
	#   systemctl show caddy -p ProtectSystem -p ReadWritePaths   # /var/log writable?
	#
	# To fall back to Caddy's default (journald) instead, delete the WHOLE
	# `output file … { … }` block — its roll_* directives and closing brace
	# included. Dropping only the `output file` line leaves them orphaned and
	# the config fails to parse, which is the same outage by another route.
	# ---------------------------------------------------------------------
	#
	# Access log. This is the ONLY access log in the stack: smcloud logs to
	# stderr (journald) but has no request logging at all, so without this
	# nothing records method, path, status, latency or client IP — and the
	# per-IP rate limiting above would be unobservable. Caddy is the right
	# layer for it: it sees the real client IP, which smcloud never does
	# behind a proxy.
	#
	# The Authorization header is DELETED explicitly rather than relying on
	# Caddy's default credential redaction. smcloud's auth is a bearer token
	# (see smcloud.env), and an access log is a long-lived file — a config
	# that silently starts logging headers must not be able to spill it.
	# Cookie is deleted for the same reason even though smcloud sets none.
	log {
		output file /var/log/caddy/smcloud-access.log {
			roll_size    10MiB
			roll_keep    5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# Request-id correlation (smcloud C4). Overwrite any client-supplied
	# X-Request-Id with a server-generated per-request UUID
	# ({http.request.uuid}, caddyserver/caddy#4285) at the public boundary.
	# request_header — NOT reverse_proxy's header_up — is deliberate: it mutates
	# the request Caddy itself logs, so the SAME id lands in BOTH this access log
	# (under request>headers>X-Request-Id, which the log block above already
	# records) AND the upstream request forwarded to smcloud. That one id ties a
	# Caddy access entry to the smcloud app line + error it produced. header_up
	# would forward the id but mutate only the upstream clone, leaving Caddy's own
	# log without it. Overwriting (no +/- prefix = set) stops a client spoofing
	# another request's id; smcloud treats X-Request-Id as an untrusted label
	# regardless — it re-validates the format (16–64 [A-Za-z0-9_-]; a UUID
	# matches) and NEVER uses it for auth — and echoes the resolved id back in the
	# response X-Request-Id header.
	request_header X-Request-Id "{http.request.uuid}"

	# smcloud listens on loopback only (SMCLOUD_LISTEN=127.0.0.1:8091);
	# Caddy terminates TLS and proxies. Bearer auth is smcloud's own.
	reverse_proxy 127.0.0.1:8091

	# A full-logbook export/backfill on a slow link can be long-running.
	# Caddy's defaults have no response timeout, so nothing to raise here —
	# this block exists so a future timeout tweak has an obvious home.
}
